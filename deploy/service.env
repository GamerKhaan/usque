# Service profile. KEY=value only; no shell expressions or quoted values.
# /etc/usque/config.json contains credentials; keep it root:usque 0640.
USQUE_CONFIG=/etc/usque/config.json
USQUE_BINARY=/opt/usque/current/usque
USQUE_STATE=/run/usque/status.json
USQUE_BIND=127.0.0.1
USQUE_PORT=903
USQUE_MODE=socks
# Optional comma-separated literal DNS IPs (at most 8); empty uses core defaults.
# Example: USQUE_DNS=1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001
# Full socks sends DNS through WARP; l4-socks resolves over the host network.
USQUE_DNS=
# Public listening requires USQUE_ALLOW_PUBLIC=true. SOCKS has no encryption
# or authentication; use a firewall and a separate authenticated transport.
USQUE_ALLOW_PUBLIC=false
USQUE_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace
USQUE_HEALTH_INTERVAL=20s
USQUE_HEALTH_TIMEOUT=8s
USQUE_HEALTH_FAILURES=3
USQUE_DIAL_TIMEOUT=8s
USQUE_SHUTDOWN_TIMEOUT=8s
USQUE_BACKOFF_MIN=1s
USQUE_BACKOFF_MAX=30s
USQUE_HEALTHY_RESET=2m
USQUE_ALWAYS_RECONNECT=true
USQUE_MTU=1280
USQUE_HTTP2=false
